# Copy to .env and replace every value. Never commit .env.

# Database (docker compose creates the database and user from these)
DB_PASSWORD=change-me-to-a-long-random-string
DB_ROOT_PASSWORD=change-me-to-a-different-long-random-string

# Public URL users reach the site at (used in password reset emails)
APP_BASE_URL=http://localhost:8080
# Keep true. Browsers accept Secure cookies on http://localhost; set false only for plain-HTTP non-localhost testing.
APP_SECURE_COOKIES=true

# Domain for the optional `https` profile (Caddy obtains a certificate automatically)
DOMAIN=draft.example.com

# Outgoing email for password resets (any SMTP provider; Gmail requires an App Password)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
